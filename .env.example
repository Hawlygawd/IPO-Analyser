# Native app only: point to the deployed Vercel serverless feed.
# Web deployments call /api/ipoFeed on the same origin automatically.
EXPO_PUBLIC_IPO_API_URL=https://your-app.vercel.app/api/ipoFeed

# Optional server-side Vercel variables (never expose these as EXPO_PUBLIC_*):
# IPOALERTS_API_KEY=
# IPOALERTS_PLAN=free
# IPOGURU_API_KEY=
# IPOALERTS_INCLUDE_GMP=false
