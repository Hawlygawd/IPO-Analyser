{
  "expo": {
    "name": "IPO Pulse",
    "slug": "ipo-pulse",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ipopulse",
    "userInterfaceStyle": "automatic",
    "description": "Track the Indian IPO board: grey market premium, category-wise subscription, key dates and plain-language analysis with reminders.",
    "primaryColor": "#0B7A54",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ipopulse.app"
    },
    "android": {
      "package": "com.ipopulse.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B7A54",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "IPO Pulse",
      "shortName": "IPO Pulse",
      "themeColor": "#0B7A54",
      "backgroundColor": "#F4F6F9",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0B7A54"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": ["ios", "android", "web"]
  }
}
