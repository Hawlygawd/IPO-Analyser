{
  "expo": {
    "name": "IPO Pulse",
    "slug": "ipo-pulse",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Indian IPO calendar, subscription figures, GMP context, and reminders.",
    "scheme": "ipopulse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ipopulse.app"
    },
    "android": {
      "package": "com.ipopulse.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#08785C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#00A870"
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
